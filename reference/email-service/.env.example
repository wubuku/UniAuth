# Required runtime profile. Do not set this in committed configuration.
SPRING_PROFILES_ACTIVE=dev

# Listener. The default bind address is loopback-only.
EMAIL_SERVICE_BIND_ADDRESS=127.0.0.1
EMAIL_SERVICE_PORT=8095
# Required when binding to anything other than loopback. Maximum 1024 characters;
# CR and LF are rejected because the value is transported in an HTTP header.
EMAIL_SERVICE_API_KEY=

# Dedicated disposable PostgreSQL database for the reference service.
EMAIL_POSTGRES_HOST=127.0.0.1
EMAIL_POSTGRES_PORT=5432
EMAIL_POSTGRES_DATABASE=uniauth_email_demo
EMAIL_POSTGRES_USER=replace-me
EMAIL_POSTGRES_PASSWORD=replace-me

# SMTP or compatible provider.
SMTP_HOST=replace-me
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLE=false
SMTP_SSL_CHECK_SERVER_IDENTITY=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000

# Sender identity.
EMAIL_FROM_ADDRESS=replace-me
EMAIL_FROM_NAME=UniAuth

# Queue behavior.
EMAIL_QUEUE_EVENT_DRIVEN=true
EMAIL_RATE_LIMIT_ENABLED=true
EMAIL_RATE_LIMIT_PER_MINUTE=10
EMAIL_MAX_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY_MINUTES=10
EMAIL_RECOVERY_ENABLED=true
EMAIL_RECOVERY_SCAN_INTERVAL_MINUTES=2
EMAIL_STUCK_TIMEOUT_MINUTES=10
